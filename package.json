{
  "name": "ai-devops-investigator",
  "version": "0.1.0",
  "description": "Evidence-Driven DevOps Incident Investigator created by Keerthivasan.R.V",
  "author": "Keerthivasan.R.V",
  "license": "MIT",
  "type": "module",
  "main": "./apps/cli/dist/index.js",
  "bin": {
    "investigator": "bin/investigator.js"
  },
  "files": [
    "bin",
    "apps/cli/dist",
    "incidents",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keerthivasan004/investigator-devops.git"
  },
  "keywords": [
    "ai",
    "devops",
    "sre",
    "incident-investigation",
    "root-cause-analysis",
    "rca",
    "causal-inference",
    "telemetry",
    "logs",
    "monitoring",
    "kubernetes",
    "observability"
  ],
  "scripts": {
    "build": "tsc -b && node ./scripts/bundle.js",
    "bundle": "node ./scripts/bundle.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "investigator": "node ./apps/cli/dist/index.js",
    "scan": "node ./apps/cli/dist/index.js scan",
    "run:incident": "node ./apps/cli/dist/index.js run",
    "eval": "node ./apps/cli/dist/index.js eval",
    "ui": "node ./apps/cli/dist/index.js ui"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
